# Weather Prediction using Bayesian Probability

# -----------------------------
# DATASET
# -----------------------------

total_days = 20

rain_days = 8
not_rain_days = 12

cloudy_rain_days = 7
cloudy_not_rain_days = 3


# -----------------------------
# PRIOR PROBABILITIES
# -----------------------------

p_rain = rain_days / total_days
p_not_rain = not_rain_days / total_days


# -----------------------------
# CONDITIONAL PROBABILITIES
# -----------------------------

p_cloudy_given_rain = cloudy_rain_days / rain_days
p_cloudy_given_not_rain = cloudy_not_rain_days / not_rain_days


# -----------------------------
# PROBABILITY OF CLOUDY
# -----------------------------

p_cloudy = (
    p_cloudy_given_rain * p_rain
    + p_cloudy_given_not_rain * p_not_rain
)


# -----------------------------
# BAYES' THEOREM
# -----------------------------

p_rain_given_cloudy = (
    p_cloudy_given_rain * p_rain
) / p_cloudy


p_not_rain_given_cloudy = (
    p_cloudy_given_not_rain * p_not_rain
) / p_cloudy


# -----------------------------
# DISPLAY RESULTS
# -----------------------------

print("======================================")
print(" WEATHER PREDICTION USING BAYES")
print("======================================")

print(f"P(Rain) = {p_rain:.2f}")
print(f"P(Not Rain) = {p_not_rain:.2f}")

print(f"P(Cloudy | Rain) = {p_cloudy_given_rain:.2f}")
print(f"P(Cloudy | Not Rain) = {p_cloudy_given_not_rain:.2f}")

print(f"P(Rain | Cloudy) = {p_rain_given_cloudy:.2f}")
print(f"P(Not Rain | Cloudy) = {p_not_rain_given_cloudy:.2f}")


# -----------------------------
# PREDICTION
# -----------------------------

if p_rain_given_cloudy > p_not_rain_given_cloudy:
    prediction = "Rain"
else:
    prediction = "Not Rain"

print("\nSky Condition = Cloudy")
print("Predicted Weather =", prediction)